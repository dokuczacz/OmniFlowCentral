{
  "title": "OmniFlow Central - Custom GPT Knowledge (AGENT ONLY)",
  "version": "2026-01-18",
  "scope": {
    "canonical": true,
    "allowed_tools": [
      "query_dataset",
      "dataset_search"
    ],
    "forbidden_tools": [
      "eli_acts_query",
      "read_blob",
      "read_many_blobs",
      "get_filtered_data",
      "manifest helpers"
    ],
    "notes": [
      "This file is the single canonical guidance for Custom GPT tool usage.",
      "Use only the GPT-only endpoints (/api/tools/gpt/*).",
      "Do not call blob helpers or manifest CRUD helpers."
    ]
  },
  "datasets": {
    "eli_acts": {
      "description": "Polish legislation (ELI / Dz.U. / M.P.) in JSONL index",
      "dataset_id": "eli_acts"
    }
  },
  "tools": {
    "query_dataset": {
      "endpoint": "/api/tools/gpt/call",
      "tool_name": "query_dataset",
      "params": {
        "dataset": {
          "required": true,
          "enum": [
            "eli_acts"
          ]
        },
        "q": {
          "required": false,
          "type": "string"
        },
        "limit": {
          "required": false,
          "type": "integer"
        },
        "fetch_content": {
          "required": false,
          "type": "boolean"
        },
        "year": {
          "required": false,
          "type": "integer"
        },
        "publisher": {
          "required": false,
          "type": "string"
        },
        "status": {
          "required": false,
          "type": "string"
        },
        "pageId": {
          "required": false,
          "type": "string",
          "description": "Deterministic lookup key. ELI id like DU/2025/1882."
        },
        "recordIndex": {
          "required": false,
          "type": "integer",
          "description": "Deterministic lookup key. Act position (pos)."
        },
        "content_slice": {
          "required": false,
          "type": "object",
          "description": "Optional excerpt control to stay under gateway limits.",
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            }
          }
        }
      },
      "filters_shape": "top_level_only",
      "filters": {
        "eli_acts": [
          "year",
          "publisher",
          "status"
        ]
      },
      "behavior": [
        "Reads the dataset index and returns matching hits.",
        "When fetch_content=true: ELI may return _fullText or _fullTextExcerpt and may set *_Truncated flags when too large."
      ],
      "workflow": {
        "index_first": [
          "Candidate search: fetch_content=false to get IDs (pageId, recordIndex) + provenance.index_path.",
          "Confirm candidate: use pageId/recordIndex, not q, for deterministic matching.",
          "Fetch bounded excerpt after confirmation (use content_slice)."
        ]
      },
      "q_syntax": {
        "boolean_subset": [
          "A OR B",
          "A AND B"
        ],
        "notes": "Case-insensitive. No parentheses or quotes."
      },
      "truncation": {
        "gateway_cap_bytes_approx": 2000000,
        "response_flag": "truncated",
        "record_flags": [
          "_fullTextTruncated",
          "_fullTextExcerptTruncated"
        ]
      },
      "provenance_fields": [
        "dataset",
        "index_path",
        "pageId",
        "recordIndex"
      ]
    },
    "dataset_search": {
      "endpoint": "/api/tools/gpt/call",
      "tool_name": "dataset_search",
      "params": {
        "user_id": {
          "required": false,
          "type": "string",
          "recommended": "public"
        },
        "category": {
          "required": false,
          "type": "string",
          "recommended": "dataset"
        },
        "tags_any": {
          "required": false,
          "type": "array"
        },
        "tags_all": {
          "required": false,
          "type": "array"
        },
        "limit": {
          "required": false,
          "type": "integer"
        },
        "cursor": {
          "required": false,
          "type": "string"
        }
      },
      "behavior": [
        "Use for manifest discovery (datasets, tags, categories)."
      ]
    }
  },
  "examples": [
    {
      "tool": "query_dataset",
      "params": {
        "dataset": "eli_acts",
        "pageId": "DU/1997/553",
        "fetch_content": true,
        "limit": 1,
        "content_slice": {
          "start": 0,
          "length": 12000
        }
      }
    },
    {
      "tool": "query_dataset",
      "params": {
        "dataset": "eli_acts",
        "pageId": "DU/2025/1882",
        "fetch_content": false
      }
    },
    {
      "tool": "dataset_search",
      "params": {
        "user_id": "public",
        "category": "dataset",
        "tags_any": [
          "legal"
        ],
        "limit": 20
      }
    }
  ],
  "citations": {
    "required_fields": [
      "dataset",
      "index_path",
      "pageId",
      "recordIndex"
    ]
  }
}

