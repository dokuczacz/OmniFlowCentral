{
  "title": "OmniFlow Central - Custom GPT Knowledge (AGENT ONLY)",
  "version": "2026-01-08",
  "scope": {
    "canonical": true,
    "allowed_tools": [
      "query_dataset",
      "dataset_search"
    ],
    "forbidden_tools": [
      "eli_acts_query",
      "read_blob",
      "read_many_blobs",
      "get_filtered_data",
      "manifest helpers"
    ],
    "notes": [
      "This file is the single canonical guidance for Custom GPT tool usage.",
      "Do not call blob helpers or manifest CRUD helpers."
    ]
  },
  "datasets": {
    "eli_acts": {
      "description": "Polish legislation (Sejm) in JSONL index",
      "dataset_id": "eli_acts"
    },
    "saos_judgments": {
      "description": "Polish court judgments (SAOS) in JSONL index",
      "dataset_id": "saos_judgments"
    }
  },
  "tools": {
    "query_dataset": {
      "endpoint": "/api/tools/call",
      "tool_name": "query_dataset",
      "params": {
        "dataset": {
          "required": true,
          "enum": [
            "eli_acts",
            "saos_judgments"
          ]
        },
        "q": {
          "required": false,
          "type": "string"
        },
        "limit": {
          "required": false,
          "type": "integer"
        },
        "fetch_content": {
          "required": false,
          "type": "boolean"
        },
        "year": {
          "required": false,
          "type": "integer"
        },
        "publisher": {
          "required": false,
          "type": "string"
        },
        "status": {
          "required": false,
          "type": "string"
        },
        "court": {
          "required": false,
          "type": "string"
        },
        "court_type": {
          "required": false,
          "type": "string"
        },
        "pageId": {
          "required": false,
          "type": "string",
          "description": "Deterministic lookup key. eli_acts: ELI id like DU/2025/1882. saos_judgments: page id like page_00001."
        },
        "recordIndex": {
          "required": false,
          "type": "integer",
          "description": "Deterministic lookup key. eli_acts: pos. saos_judgments: index within page array (requires pageId)."
        }
      },
      "filters_shape": "top_level_only",
      "filters": {
        "eli_acts": [
          "year",
          "publisher",
          "status"
        ],
        "saos_judgments": [
          "court",
          "court_type",
          "year"
        ]
      },
      "behavior": [
        "Reads the dataset index and returns matching hits.",
        "When fetch_content=true, returns full SAOS judgment content; ELI returns metadata only (no act text stored yet)."
      ],
      "workflow": {
        "index_first": [
          "Candidate search: fetch_content=false to get IDs (pageId, recordIndex) + provenance.index_path.",
          "Confirm candidate: use pageId/recordIndex, not q, for deterministic matching.",
          "Fetch content after confirmation (SAOS only)."
        ]
      },
      "q_syntax": {
        "boolean_subset": [
          "A OR B",
          "A AND B"
        ],
        "notes": "Case-insensitive. No parentheses or quotes."
      },
      "truncation": {
        "soft_cap_bytes_approx": 2000000,
        "response_flag": "truncated",
        "record_flag": "_contentTruncated"
      },
      "provenance_fields": [
        "dataset",
        "index_path",
        "pageId",
        "recordIndex"
      ]
    },
    "dataset_search": {
      "endpoint": "/api/tools/call",
      "tool_name": "dataset_search",
      "params": {
        "user_id": {
          "required": false,
          "type": "string",
          "recommended": "public"
        },
        "category": {
          "required": false,
          "type": "string",
          "recommended": "dataset"
        },
        "tags_any": {
          "required": false,
          "type": "array"
        },
        "tags_all": {
          "required": false,
          "type": "array"
        },
        "limit": {
          "required": false,
          "type": "integer"
        },
        "cursor": {
          "required": false,
          "type": "string"
        }
      },
      "behavior": [
        "Use for manifest discovery (datasets, tags, categories)."
      ]
    }
  },
  "examples": [
    {
      "tool": "query_dataset",
      "params": {
        "dataset": "saos_judgments",
        "q": "Amber Gold",
        "limit": 5,
        "fetch_content": true,
        "court_type": "common"
      }
    },
    {
      "tool": "query_dataset",
      "params": {
        "dataset": "eli_acts",
        "pageId": "DU/2025/1882",
        "fetch_content": false
      }
    },
    {
      "tool": "dataset_search",
      "params": {
        "user_id": "public",
        "category": "dataset",
        "tags_any": [
          "legal"
        ],
        "limit": 20
      }
    }
  ],
  "citations": {
    "required_fields": [
      "dataset",
      "index_path",
      "pageId",
      "recordIndex"
    ]
  }
}
